# Master / control-plane environment. Install as /etc/sched/master.env with
# mode 0640 and owner root:sched. server and scheduler read the same file.
#
# Replace every CHANGE_ME value. Generate tokens with: openssl rand -hex 32
SCHED_DATABASE_URL='postgres://sched:CHANGE_ME@db.internal:5432/sched?sslmode=require'
SCHED_REDIS_URL='redis://:CHANGE_ME@redis.internal:6379/0'

# Bind to loopback; Caddy/nginx owns 443 and fans out /v1, /worker/v1, /ui.
SCHED_API_ADDR='127.0.0.1:8080'
SCHED_WORKER_ADDR='127.0.0.1:8081'

# Public Worker Gateway URL reachable from every Worker.
SCHED_GATEWAY_URL='https://sched.example.com'

# Console bearer token (P0 single token) and the deployment-wide Worker token.
# These are different secrets.
SCHED_DEV_TOKEN='CHANGE_ME_CONSOLE_TOKEN'
SCHED_WORKER_TOKEN='CHANGE_ME_WORKER_TOKEN'

# Central log cache and migration directory. Keep the log directory persistent.
SCHED_LOG_ROOT='/var/lib/sched/logs'
SCHED_MIGRATIONS_DIR='/opt/sched/migrations'

# Recorded in sched_node for visibility; does not receive callbacks in P0.
SCHED_NODE_ADDR='https://sched.example.com'

# Optional; a stable UUID per scheduler replica is recommended.
# Omit to generate a new random node id on every start.
# SCHED_NODE_ID='00000000-0000-4000-8000-000000000001'

# Optional tuning; these are the defaults.
SCHED_PRESENCE_TTL='60s'
SCHED_HEARTBEAT_INTERVAL='20s'
SCHED_LEADER_LOCK_TTL='10s'
